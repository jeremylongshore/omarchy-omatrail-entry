{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "HuntingRules.js:295:0-337:0",
    "HuntingRules.js:338:0-374:0",
    "HuntingRules.js:405:0-418:0",
    "JourneyRules.js:593:0-611:0",
    "JourneyRules.js:638:0-668:0",
    "JourneyRules.js:916:0-931:0"
  ],
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test --test-skip-pattern='10,000 generated fields|a careful supply' tests/hunting.test.js tests/journey.test.js"
  },
  "mutator": {
    "excludedMutations": ["StringLiteral", "ObjectLiteral"]
  },
  "reporters": ["clear-text", "json"],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "thresholds": {
    "high": 95,
    "low": 90,
    "break": 90
  },
  "concurrency": 2
}
